<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire -->
    <record id="view_logement_form" model="ir.ui.view">
        <field name="name">knsai.logement.form</field>
        <field name="model">knsai.logement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_archive" type="object" class="oe_stat_button" icon="fa-archive">
                        <field name="active" widget="boolean_button"/>
                    </button>
                    <field name="etat" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du logement..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="surface"/>
                            <field name="nb_pieces"/>
                        </group>
                        <group>
                            <field name="proprietaire_id"/>
                            <field name="locataire_id"/>
                            <field name="date_diagnostic"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Informations générales">
                            <group>
                                <field name="adresse"/>
                                <field name="diagnostic"/>
                            </group>
                        </page>
                        <page string="Photos">
                            <field name="photos" widget="many2many_binary"/>
                        </page>
                        <page string="Historique">
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue liste -->
    <record id="view_logement_list" model="ir.ui.view">
        <field name="name">knsai.logement.list</field>
        <field name="model">knsai.logement</field>
        <field name="arch" type="xml">
            <tree>
                <field name="reference"/>
                <field name="name"/>
                <field name="adresse"/>
                <field name="proprietaire_id"/>
                <field name="locataire_id"/>
                <field name="etat"/>
                <field name="surface"/>
                <field name="date_modification"/>
            </tree>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="view_logement_search" model="ir.ui.view">
        <field name="name">knsai.logement.search</field>
        <field name="model">knsai.logement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="adresse"/>
                <field name="proprietaire_id"/>
                <field name="locataire_id"/>
                <separator/>
                <filter string="Neuf" name="neuf" domain="[('etat','=','neuf')]"/>
                <filter string="Bon état" name="bon" domain="[('etat','=','bon')]"/>
                <filter string="État moyen" name="moyen" domain="[('etat','=','moyen')]"/>
                <filter string="Mauvais état" name="mauvais" domain="[('etat','=','mauvais')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Propriétaire" name="group_by_proprietaire" context="{'group_by':'proprietaire_id'}"/>
                    <filter string="Locataire" name="group_by_locataire" context="{'group_by':'locataire_id'}"/>
                    <filter string="État" name="group_by_etat" context="{'group_by':'etat'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_logement" model="ir.actions.act_window">
        <field name="name">Logements</field>
        <field name="res_model">knsai.logement</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_logement_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau logement
            </p>
        </field>
    </record>
</odoo> 