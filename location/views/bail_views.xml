<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire -->
    <record id="view_bail_form" model="ir.ui.view">
        <field name="name">knsai.bail.form</field>
        <field name="model">knsai.bail</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activer" string="Activer" type="object" class="oe_highlight" attrs="{'invisible': [('etat', '!=', 'brouillon')]}"/>
                    <button name="action_terminer" string="Terminer" type="object" class="oe_highlight" attrs="{'invisible': [('etat', '!=', 'actif')]}"/>
                    <button name="action_resilier" string="Résilier" type="object" class="oe_highlight" attrs="{'invisible': [('etat', '!=', 'actif')]}"/>
                    <field name="etat" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="logement_id"/>
                            <field name="bailleur_id"/>
                            <field name="locataire_id"/>
                        </group>
                        <group>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="montant_loyer"/>
                            <field name="montant_charges"/>
                            <field name="montant_depot_garantie"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Paiements">
                            <field name="paiement_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="montant"/>
                                    <field name="type_paiement"/>
                                    <field name="mode_paiement"/>
                                    <field name="etat"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="date"/>
                                                <field name="montant"/>
                                            </group>
                                            <group>
                                                <field name="type_paiement"/>
                                                <field name="mode_paiement"/>
                                                <field name="etat"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Relances">
                            <field name="relance_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="montant"/>
                                    <field name="type_relance"/>
                                    <field name="etat"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="date"/>
                                                <field name="montant"/>
                                            </group>
                                            <group>
                                                <field name="type_relance"/>
                                                <field name="etat"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Documents">
                            <field name="documents"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue liste -->
    <record id="view_bail_tree" model="ir.ui.view">
        <field name="name">knsai.bail.tree</field>
        <field name="model">knsai.bail</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="logement_id"/>
                <field name="locataire_id"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="montant_loyer"/>
                <field name="etat"/>
            </tree>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="view_bail_search" model="ir.ui.view">
        <field name="name">knsai.bail.search</field>
        <field name="model">knsai.bail</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="logement_id"/>
                <field name="bailleur_id"/>
                <field name="locataire_id"/>
                <separator/>
                <filter string="Brouillons" name="brouillon" domain="[('etat', '=', 'brouillon')]"/>
                <filter string="Actifs" name="actif" domain="[('etat', '=', 'actif')]"/>
                <filter string="Terminés" name="termine" domain="[('etat', '=', 'termine')]"/>
                <filter string="Résiliés" name="resilie" domain="[('etat', '=', 'resilie')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Logement" name="group_by_logement" context="{'group_by': 'logement_id'}"/>
                    <filter string="Bailleur" name="group_by_bailleur" context="{'group_by': 'bailleur_id'}"/>
                    <filter string="Locataire" name="group_by_locataire" context="{'group_by': 'locataire_id'}"/>
                    <filter string="État" name="group_by_etat" context="{'group_by': 'etat'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bail" model="ir.actions.act_window">
        <field name="name">Baux</field>
        <field name="res_model">knsai.bail</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_actif': 1}</field>
    </record>
</odoo> 